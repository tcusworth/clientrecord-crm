+'use client';
+
+import { FormEvent, useEffect, useState } from 'react';
+import { invoke } from '@tauri-apps/api/core';
+import { toast } from 'sonner';
+import { Button } from '@/components/ui/button';
+
+type Config = { endpoint: string; tokenConfigured: boolean; cloudflareAccessConfigured: boolean; autoSend: boolean };
+
+export function ClientRecordIntegration() {
+  const [config, setConfig] = useState<Config | null>(null);
+  const [endpoint, setEndpoint] = useState('https://clientrecordcrm.com/api/integrations/meetily/meetings');
+  const [apiToken, setApiToken] = useState('');
+  const [clientId, setClientId] = useState('');
+  const [clientSecret, setClientSecret] = useState('');
+  const [autoSend, setAutoSend] = useState(true);
+  const [busy, setBusy] = useState('');
+
+  useEffect(() => {
+    void invoke<Config>('clientrecord_get_config').then(value => {
+      setConfig(value); setEndpoint(value.endpoint); setAutoSend(value.autoSend);
+    }).catch(error => toast.error('Could not load ClientRecord settings', { description: String(error) }));
+  }, []);
+
+  const save = async (event: FormEvent<HTMLFormElement>) => {
+    event.preventDefault(); setBusy('save');
+    try {
+      const value = await invoke<Config>('clientrecord_save_config', { endpoint, apiToken, cfAccessClientId: clientId, cfAccessClientSecret: clientSecret, autoSend });
+      setConfig(value); setApiToken(''); setClientId(''); setClientSecret('');
+      toast.success('ClientRecord connection saved');
+    } catch (error) { toast.error('Could not save ClientRecord settings', { description: String(error) }); }
+    finally { setBusy(''); }
+  };
+
+  const test = async () => {
+    setBusy('test');
+    try { await invoke('clientrecord_test_connection'); toast.success('Connected to ClientRecord'); }
+    catch (error) { toast.error('ClientRecord connection failed', { description: String(error) }); }
+    finally { setBusy(''); }
+  };
+
+  return <div className="mt-6 max-w-3xl rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
+    <div className="flex flex-wrap items-start justify-between gap-3">
+      <div><h2 className="text-xl font-semibold text-gray-900">ClientRecord CRM</h2><p className="mt-1 text-sm leading-6 text-gray-600">Send the finished transcript and summary directly to the matching CRM deal. Recorded audio is never uploaded.</p></div>
+      <span className={`rounded-full px-3 py-1 text-xs font-medium ${config?.tokenConfigured ? 'bg-green-100 text-green-700' : 'bg-amber-100 text-amber-800'}`}>{config?.tokenConfigured ? 'Configured' : 'Setup required'}</span>
+    </div>
+    <form onSubmit={save} className="mt-6 grid gap-4">
+      <label className="grid gap-1.5 text-sm font-medium text-gray-800">Receiver endpoint<input className="h-10 rounded-md border border-gray-300 px-3 font-normal" type="url" required value={endpoint} onChange={event => setEndpoint(event.target.value)} /></label>
+      <label className="grid gap-1.5 text-sm font-medium text-gray-800">ClientRecord connector token<input className="h-10 rounded-md border border-gray-300 px-3 font-normal" type="password" value={apiToken} onChange={event => setApiToken(event.target.value)} placeholder={config?.tokenConfigured ? 'Saved — leave blank to keep it' : 'cr_live_…'} /></label>
+      <div className="rounded-lg bg-gray-50 p-4"><h3 className="text-sm font-semibold text-gray-900">Cloudflare Access service token</h3><p className="mt-1 text-xs leading-5 text-gray-600">Required when ClientRecord is protected by Cloudflare Access. Create a Service Auth token and allow it in the ClientRecord Access application.</p><div className="mt-3 grid gap-3 sm:grid-cols-2"><label className="grid gap-1 text-xs font-medium text-gray-700">Client ID<input className="h-10 rounded-md border border-gray-300 bg-white px-3 text-sm font-normal" type="password" value={clientId} onChange={event => setClientId(event.target.value)} placeholder={config?.cloudflareAccessConfigured ? 'Saved — leave blank to keep' : 'Service token client ID'} /></label><label className="grid gap-1 text-xs font-medium text-gray-700">Client secret<input className="h-10 rounded-md border border-gray-300 bg-white px-3 text-sm font-normal" type="password" value={clientSecret} onChange={event => setClientSecret(event.target.value)} placeholder={config?.cloudflareAccessConfigured ? 'Saved — leave blank to keep' : 'Service token client secret'} /></label></div></div>
+      <label className="flex items-start gap-3 rounded-lg border border-gray-200 p-4"><input className="mt-1" type="checkbox" checked={autoSend} onChange={event => setAutoSend(event.target.checked)} /><span><strong className="block text-sm text-gray-900">Send automatically after summary generation</strong><span className="mt-1 block text-xs leading-5 text-gray-600">If ClientRecord cannot identify one deal, the meeting appears in its association queue for review.</span></span></label>
+      <div className="flex flex-wrap gap-3"><Button disabled={Boolean(busy)} type="submit">{busy === 'save' ? 'Saving…' : 'Save connection'}</Button><Button disabled={Boolean(busy) || !config?.tokenConfigured} type="button" variant="outline" onClick={() => void test()}>{busy === 'test' ? 'Testing…' : 'Test connection'}</Button></div>
+    </form>
+  </div>;
+}
