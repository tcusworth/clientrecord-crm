{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": { "@/*": ["../*"] },
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["src/**/*.ts", "../cloudflare-env.d.ts"]
}
