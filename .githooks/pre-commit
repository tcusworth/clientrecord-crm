#!/bin/sh
# Block commits that add secrets. Enable with: git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed; skipping secret scan (brew install gitleaks)." >&2
  exit 0
fi
gitleaks git --pre-commit --staged --redact --no-banner . || {
  echo "pre-commit: gitleaks found a possible secret in your staged changes. Remove it, or add its fingerprint to .gitleaksignore if it is a false positive." >&2
  exit 1
}
